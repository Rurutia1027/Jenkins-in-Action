pipeline {
    agent any

    stages {
        stage('Unit Tests -- Backend') {
            agent {
                docker {
                    image 'snakee/golang-junit:1.21'
                    reuseNode true
                }
            }
            environment {
                HOME    = "${WORKSPACE}"
                GOCACHE = "${WORKSPACE}/.gocache"
                GOPATH  = "${WORKSPACE}/.gopath"
            }
            steps {
                dir('bugtracker-backend') {
                    sh 'go test -v ./...'
                }
            }
        }
        stage('Unit Tests -- Frontend') {
            agent {
                docker {
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            environment {
                HOME    = "${WORKSPACE}"
                NODE_ENV = 'test'
            }
            steps {
                dir('bugtracker-frontend') {
                    sh 'npm ci'
                    sh 'npm test'
                }
            }
        }
    }
}