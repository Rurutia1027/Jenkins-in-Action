pipeline {
    agent any

    stages {
        stage('Execute Unit Tests') {
            parallel {
                stage('Unit Tests -- Backend') {
                    agent {
                        docker {
                            image 'snakee/golang-junit:1.21'
                            reuseNode true
                            args '--network host --dns 127.0.0.11'
                        }
                    }
                    options { skipDefaultCheckout() }
                    environment {
                        HOME    = "${WORKSPACE}"
                        GOCACHE = "${WORKSPACE}/.gocache"
                        GOPATH  = "${WORKSPACE}/.gopath"
                    }
                    steps {
                        dir('bugtracker-backend') {
                            sh '''
                            # Run ut cases, and gen test report in xml format
                            go test -v ./... 2>&1 | go-junit-report -set-exit-code > test-results.xml

                            # Generate coverage report
                            go test -coverprofile=coverage.out ./... && go tool cover -html=coverage.out -o coverage.html

                            mkdir -p reports
                            mv coverage.html reports/
                            '''
                        }
                    }
                    post {
                        always {
                            junit 'bugtracker-backend/test-results.xml'
                            publishHTML target: [
                                reportDir: 'bugtracker-backend/reports',
                                reportFiles: 'coverage.html',
                                reportName: 'Backend Coverage Report'
                            ]
                        }
                    }
                }

                stage('Unit Tests -- Frontend') {
                    agent {
                        docker {
                            image 'node:20-alpine'
                            reuseNode true
                            args '--network host --dns 127.0.0.11'
                        }
                    }
                    options { skipDefaultCheckout() }
                    environment {
                        HOME     = "${WORKSPACE}"
                        NODE_ENV = 'test'
                    }
                    steps {
                        dir('bugtracker-frontend') {
                            sh '''
                            npm ci
                            npm test
                            rm -rf reports/
                            mkdir -p reports
                            mv coverage reports/
                            '''
                        }
                    }
                    post {
                        always {
                            junit 'bugtracker-frontend/test-results.xml'
                            publishHTML target: [
                                reportDir: 'bugtracker-frontend/reports/coverage',
                                reportFiles: 'index.html',
                                reportName: 'Frontend Coverage Report'
                            ]
                        }
                    }
                }
            }
        }

        stage('Launch Application') {
            agent {
                docker {
                    image 'docker:27.5.1-cli'
                    reuseNode true
                    args '--network host --dns 127.0.0.11 -v /var/run/docker.sock:/var/run/docker.sock -u 0'
                }
            }
            options { skipDefaultCheckout() }

            steps {
                sh 'docker compose up --build --pull never -d'
            }
        }

        stage('Test Application') {
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.50.0-jammy'
                    reuseNode true
                    alwaysPull false
                    args '--network host --dns 127.0.0.11 -u 0'
                }
            }
            options { skipDefaultCheckout() }

            steps {
                dir('tests-api') {
                    sh 'npx wait-port http://localhost:8080/api/health -t 30000'
                    sh 'npm ci'
                    sh 'npx playwright test'
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
